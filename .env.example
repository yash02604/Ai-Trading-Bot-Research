# Copy to .env and fill locally. Never commit .env or real credentials.
UPSTOX_ACCESS_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
API_TIMEOUT_SECONDS=10
PAPER_TRADING=true
PAPER_INITIAL_CAPITAL=100000
# Copy each exact instrument_key from Upstox's official instrument master.
# Index keys use the documented <segment>|<trading_symbol> form; do not guess or substitute symbols.
UPSTOX_NIFTY50_KEY=
UPSTOX_NIFTY_BANK_KEY=
UPSTOX_NIFTY_IT_KEY=
UPSTOX_SENSEX_KEY=
