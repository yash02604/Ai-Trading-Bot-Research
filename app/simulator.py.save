from datetime import datetime, timedelta

from app.trading_engine import TradingEngine


def build_test_market_data(price, previous_price, timestamp):
    return {
        "symbol": "SIM",
        "timestamp": timestamp,
        "close": price,
        "ema_9": price - 0.5,
        "ema_20": price - 1.5,
        "rsi_14": 55.0,
        "macd": 1.5,
        "macd_signal": 1.0,
        "macd_histogram": 0.5,
        "volume": 120000,
        "volume_ma_20": 100000,
        "open": previous_price,
        "high": price + 1.0,
        "low": price - 1.0,
        "prev_close": previous_price,
        "stop_loss": price - 5.0,
    }


def run_simulation():
    engine = TradingEngine()

    start_time = datetime.now()

    prices = [
        100,
        101,
        102,
        103,
        104,
        105,
        106,
        107,
        108,
        109,
    ]

    print("===== MULTI-CANDLE SIMULATION =====")
    print("Candles:", len(prices))
    print()

    previous_price = prices[0]

    for index, price in enumerate(prices):
        timestamp = start_time + timedelta(minutes=5 * index)

        market_data = build_test_market_data(
            price=price,
            previous_price=previous_price,
            timestamp=timestamp,
        )

        print(f"===== CANDLE {index + 1} =====")
        print("Time:", timestamp)
        print("Price:", price)

        result = engine.process_market(market_data)

        print("Result:", result)
        print()

        previous_price = price

    print("===== SIMULATION COMPLETE =====")
    print("Trades recorded:", len(engine.paper_trader.trades))
    print("Daily loss:", engine.paper_trader.state.daily_loss)
    print("Trades today:", engine.paper_trader.state.trades_today)
    print("Open position:", engine.paper_trader.position)


if __name__ == "__main__":
    run_simulation()
